#!/bin/sh
set -eu
die() { printf 'port: %s\n' "$*" >&2; exit 2; }
usage() { printf '%s\n' 'port fetch|path|install|develop|uninstall|clean ORG/REPO[=URL]'; }
action=${1:-}
case $action in -h|--help) usage; exit ;; esac
[ "$#" -ge 2 ] || { usage >&2; exit 2; }
shift
if [ "$action" = files ]; then
    [ "$#" -ge 4 ] || die 'missing file installation arguments'
    mode=$1 source=$2 root=$3$4
    case $3:$4 in /*:/*|:/*) ;; *) die 'use absolute PREFIX and DESTDIR paths' ;; esac
    shift 4
    case $mode in install|develop|uninstall) ;; *) die "invalid file action $mode" ;; esac
    root=${root%/}
    # Derive the installed paths from the declarations for both install and
    # uninstall. A package may share directories, but owns its file names.
    kind=program
    for entry do
        if [ "$entry" = -- ]; then
            case $kind in program) kind=alias ;; alias) kind=data ;; esac
            continue
        fi
        case $kind in
            program) from=$source/$entry; to=$root/bin/${entry##*/}; permissions=755 ;;
            alias) from=${entry#*=}; to=$root/bin/${entry%%=*}; permissions= ;;
            data) from=$source/$entry; to=$root/$entry; permissions=644; [ ! -x "$from" ] || permissions=755 ;;
        esac
        if [ "$mode" = uninstall ]; then
            rm -f -- "$to"
            continue
        fi
        directory=${to%/*}
        mkdir -p "$directory"
        stage=$(mktemp -d "$directory/.port.XXXXXXXX")
        trap 'rm -rf -- "$stage"' 0
        if [ "$kind" = alias ] || [ "$mode" = develop ]; then
            ln -s -- "$from" "$stage/file"
        else
            install -m "$permissions" -- "$from" "$stage/file"
        fi
        # Replace the link itself when switching between install and develop.
        [ ! -d "$to" ] || die "destination is a directory: $to"
        mv -f -- "$stage/file" "$to"
        rmdir "$stage"
        trap - 0
    done
    exit
fi

[ "$#" -eq 1 ] || die 'expected one port'
name=${1%%=*}
case $name in
    *[!a-zA-Z0-9_./-]*|.*|/*|-*|*/*/*|*/|*/.*|*/-*) die "invalid port name $name" ;;
    */*) ;;
    *) die 'expected organization/repository' ;;
esac
case $1 in *=*) url=${1#*=} ;; *) url=${GIT_ROOT:-https://github.com}/$name ;; esac
[ -n "$url" ] || die "missing URL for $name"
cache=${PORTS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/new-world}
source=${PORTS_SOURCE:-$PWD}
case $source in /*) ;; *) source=$PWD/$source ;; esac
case $cache in /*) ;; *) cache=$PWD/$cache ;; esac
if [ -f "$source/$name/Makefile" ]; then
    source=$source/$name
else
    source=$cache/$name
fi

fetch() (
    [ ! -f "$source/Makefile" ] || return 0
    mkdir -p "${source%/*}"
    lock=$source.lock
    attempt=0
    until mkdir "$lock" 2>/dev/null; do
        [ ! -f "$source/Makefile" ] || return 0
        attempt=$((attempt + 1))
        [ "$attempt" -lt 60 ] || die "waiting for $lock"
        sleep 1
    done
    stage=
    trap '[ -z "$stage" ] || rm -rf "$stage"; rmdir "$lock"' 0
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    [ ! -f "$source/Makefile" ] || return 0
    [ ! -e "$source" ] && [ ! -L "$source" ] || die "source already exists: $source"
    stage=$(mktemp -d "${source%/*}/.clone.XXXXXXXX")
    git clone -- "$url" "$stage/source"
    if [ -x "$stage/source/configure" ]; then (cd "$stage/source"; ./configure >&2); fi
    [ -f "$stage/source/Makefile" ] || die "$name has no Makefile"
    mv "$stage/source" "$source"
)

case $action in
    fetch|install|develop) fetch ;;
    path|uninstall|clean) ;;
    *) usage >&2; exit 2 ;;
esac
[ -f "$source/Makefile" ] || die "source unavailable: $source"
case $action in
    fetch|path) printf '%s\n' "$source" ;;
    *) exec "${MAKE:-make}" -C "$source" "$action" ;;
esac
