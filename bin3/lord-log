#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: lord-log [latest|list|path|stdin|stdout|stderr|status|argv|cwd|input|started|finished|runner|effort|permission|program] [ID]'
}
journal=${LORD_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/lord}
field=${1:-latest}
case $field in
    -h|--help) usage; exit ;;
    list)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        for record in "$journal"/run.*; do
            [ ! -f "$record/status" ] || printf '%s\n' "${record##*/}"
        done
        exit ;;
    latest|path|stdin|stdout|stderr|status|argv|cwd|input|started|finished|runner|effort|permission|program) ;;
    *) usage >&2; exit 2 ;;
esac
[ "$#" -le 2 ] || { usage >&2; exit 2; }
id=${2:-}
if [ -z "$id" ] && [ -f "$journal/latest" ]; then
    IFS= read -r id < "$journal/latest"
fi
case $id in
    run.*) case $id in *[!a-zA-Z0-9.]*) exit 2 ;; esac ;;
    *) printf '%s\n' 'lord-log: no completed run' >&2; exit 1 ;;
esac
record=$journal/$id
[ -f "$record/status" ] || { printf 'lord-log: unknown run %s\n' "$id" >&2; exit 1; }
case $field in
    latest) printf '%s\n' "$id" ;;
    path) printf '%s\n' "$record" ;;
    *) cat "$record/$field" ;;
esac
