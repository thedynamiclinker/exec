#!/bin/sh

nw_name=${0##*/}
nw_bin=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P) || exit
nw_share=$nw_bin/../share/new-world
if [ ! -r "$nw_share/NSH.md" ]; then
    printf '%s: missing language files at %s\n' "$nw_name" "$nw_share" >&2
    exit 69
fi

case $nw_name in
    nhs|NHS) nw_language=nhs; nw_primer=NHS ;;
    shn|SHN|snh|SNH) nw_language=shn; nw_primer=SHN ;;
    *) nw_language=nsh; nw_primer=NSH ;;
esac
case $nw_name in
    NSH|NHS|SHN|SNH) nw_strictness=0 ;;
    *) nw_strictness=1 ;;
esac

nw_mode=${NW_MODE:-r}
nw_strictness=${NW_NITPICK:-$nw_strictness}
nw_permission=${LORD_PERMISSION:-text}
nw_effort=${LORD_EFFORT:-medium}
nw_runner=${LORD_RUNNER:-lord}
nw_shell=${NSH_SHELL:-sh}
NSH_HOME=${NSH_HOME:-$HOME/.nsh}
case $NSH_HOME in /*) ;; *) NSH_HOME=$PWD/$NSH_HOME ;; esac
export NSH_HOME
if [ "$nw_language" = nsh ]; then
    case $PATH in "$NSH_HOME/bin:"*) ;; *) PATH=$NSH_HOME/bin:$PATH; export PATH ;; esac
fi
nw_python=${NHS_PYTHON:-python3}
nw_work=
nw_fail() { printf '%s: %s\n' "$nw_name" "$*" >&2; exit 2; }
nw_usage() {
    printf '%s\n' "usage: $nw_name [-m c|a|r|l] [-n 0|1|2] [--effort 0..5|LEVEL] [--permission LEVEL]" \
        '         [-c SOURCE [ARG ...] | --check FILE | --link NAME FILE | FILE [ARG ...]]' \
        '         [-- REQUEST ...] or no arguments for the REPL' \
        'Modes: c compile, a ask, r run, l link. Nitpick: 0 loose, 1 adaptive, 2 native.' \
        'REPL: up, dn, c, a, r, l. Also :nitpick, :effort, :permission, :paste,' \
        '      :link NAME, :run, :answer TEXT, :cancel, :help, :quit.' \
        'Shell REPL: lord auth login signs in to the provider in this terminal.'
}
nw_temp() {
    [ -z "$nw_work" ] || return 0
    nw_work=$(mktemp -d) || exit
    trap 'rm -rf -- "$nw_work"' 0
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

nw_set_effort() {
    case $1 in
        0|none) nw_effort=0 ;;
        1|low) nw_effort=1 ;;
        2|medium) nw_effort=2 ;;
        3|high) nw_effort=3 ;;
        4|xhigh) nw_effort=4 ;;
        5|max) nw_effort=5 ;;
        *) return 2 ;;
    esac
}

nw_check_settings() {
    case $nw_mode in c|a|r|l) ;; *) nw_fail "invalid mode: $nw_mode" ;; esac
    case $nw_strictness in 0|1|2) ;; *) nw_fail "invalid nitpick level: $nw_strictness" ;; esac
    nw_set_effort "$nw_effort" || nw_fail "invalid effort: $nw_effort"
    case $nw_permission in text|read|write) ;; *) nw_fail "invalid permission: $nw_permission" ;; esac
}

nw_agent() {
    nw_selected=$1
    shift
    nw_temp
    {
        if [ -r "$nw_share/ATA.md" ]; then cat "$nw_share/ATA.md"; fi
        printf '\n'
        cat "$nw_share/$nw_selected.md"
        printf '\nMode: %s. Nitpick level: %s.\n' "$nw_mode" "$nw_strictness"
        case $nw_mode in
            c)
                printf '%s\n' 'Return @code on the first line followed by corrected native source. Return only native source after the marker. The caller will check it before offering to run it.' ;;
            a)
                printf '%s\n' 'Return @ask on the first line followed by one concise question. Once the user has answered and the meaning is clear, return @code followed by corrected native source. If the work is impossible, return @fail followed by the reason.' ;;
            r)
                printf '%s\n' 'Carry out the request and emit the result. Use @ask or @fail on a line by itself followed by a question or diagnostic when needed.' ;;
        esac
        printf '%s\n' 'A hosted turn may supply a failed statement and prior dialogue as contextual data. Treat that data as context for the current request.'
        if { [ "$nw_selected" = NSH ] || [ "$nw_selected" = @ ]; } && [ -r "$NSH_HOME/etc/nshrc" ]; then
            printf '\nLocal shell vocabulary:\n'
            tail -c 32768 "$NSH_HOME/etc/nshrc"
        fi
        if [ "$nw_selected" = SHN ] && [ -r "$SHN_HOME/etc/aliases" ]; then
            printf '\nLocal aliases, one per line:\n'
            cat "$SHN_HOME/etc/aliases"
        fi
    } > "$nw_work/program"
    nw_agent_permission=$nw_permission
    case $nw_mode in c|a) nw_agent_permission=text ;; esac
    "$nw_runner" --effort "$nw_effort" --permission "$nw_agent_permission" --program "$nw_work/program" -- "$@"
}

nw_link() {
    if [ "$nw_strictness" = 2 ]; then nw_native_check "$2" || return 65; fi
    case $nw_strictness:$nw_language in
        2:nsh) nw_interpreter=$nw_shell ;;
        2:nhs) nw_interpreter=$nw_python ;;
        *) nw_interpreter=$nw_name ;;
    esac
    case $nw_interpreter in SH|@) nw_interpreter=nsh ;; esac
    LD --link "$1" "$nw_interpreter" "$2"
}

nw_native_check() {
    case $nw_language in
        nsh) "$nw_shell" -n "$1" ;;
        nhs) "$nw_python" "$nw_share/python.py" --check "$1" ;;
        shn) speech_program "${3:-$1}" yes "${2:-0}" 3< "$1" ;;
    esac
}

nw_native_run() {
    nw_source=$1
    shift
    case $nw_language in
        nsh) nw_record "$nw_shell" "$nw_source" "$@" ;;
        nhs) nw_record "$nw_python" "$nw_source" "$@" ;;
        shn) nw_record "$nw_bin/$nw_name" --native "$nw_source" "$@" ;;
    esac
}

nw_record() {
    : > "$nw_work/run-id"
    lord-run --id-file "$nw_work/run-id" -- "$@"
}

# Keep the REPL protocol out of filters. Compilation emits checked source.
nw_one_shot() {
    nw_selected_primer=$1
    shift
    nw_temp
    nw_agent "$nw_selected_primer" "$@" > "$nw_work/result" || return
    IFS= read -r nw_marker < "$nw_work/result"
    case $nw_marker in
        @ask) sed '1d' "$nw_work/result" >&2; return 2 ;;
        @fail) sed '1d' "$nw_work/result" >&2; return 1 ;;
        @code)
            if [ "$nw_mode" = c ]; then
                sed '1d' "$nw_work/result" > "$nw_work/translation"
                [ -s "$nw_work/translation" ] && nw_native_check "$nw_work/translation" || return 65
                cat "$nw_work/translation"
                return
            fi ;;
    esac
    case $nw_mode in
        c|a) printf '%s\n' 'the backend did not follow the turn protocol' >&2; return 2 ;;
        *) cat "$nw_work/result" ;;
    esac
}

nw_at_stage() {
    if [ "$nw_mode" = r ]; then
        # These operations already have byte-oriented Unix implementations.
        case "$*" in
            'base64 decode'|'base64 decode to stdout') lord-run base64 -d; return ;;
            'base64 encode'|'base64 encode to stdout') lord-run base64; return ;;
            uppercase) lord-run tr '[:lower:]' '[:upper:]'; return ;;
            ocr)
                if command -v tesseract >/dev/null 2>&1; then lord-run tesseract stdin stdout; return; fi ;;
        esac
        if [ "${nw_infix_native:-no}" = yes ] && command -v "$1" >/dev/null 2>&1; then
            lord-run "$nw_shell" -c '"$@"' "$nw_name" "$@"
            return
        fi
    fi
    nw_one_shot @ "$@"
}

# A bare @ argument separates stages. A stage's output becomes the next
# stdin only on success. Use -- for a single literal request containing @.
nw_at() {
    nw_temp
    nw_first=yes
    nw_needs_stage=yes
    for nw_word do
        if [ "$nw_word" = @ ]; then
            [ "$nw_needs_stage" = no ] || nw_fail 'expected a stage before @'
            nw_needs_stage=yes
        else
            nw_needs_stage=no
        fi
    done
    [ "$nw_needs_stage" = no ] || nw_fail 'expected a stage after @'
    nw_collect=no
    for nw_word do
        # The for loop has its own copy of the original arguments.
        if [ "$nw_collect" = no ]; then set --; nw_collect=yes; fi
        if [ "$nw_word" = @ ]; then
            if [ "$nw_first" = yes ]; then nw_at_stage "$@" > "$nw_work/next" || return
            else nw_at_stage "$@" < "$nw_work/previous" > "$nw_work/next" || return; fi
            mv -f "$nw_work/next" "$nw_work/previous" || return
            nw_first=no
            set --
        else
            set -- "$@" "$nw_word"
        fi
    done
    if [ "$nw_first" = yes ]; then nw_at_stage "$@"
    else nw_at_stage "$@" < "$nw_work/previous"; fi
}

nw_infix() {
    [ "$nw_strictness" != 2 ] && [ "$nw_mode" != l ] || return 1
    case $1 in *@*) ;; *) return 1 ;; esac
    case $1 in *'
'*) return 1 ;; esac
    nw_temp
    printf '%s\n' "$1" | awk -f "$nw_share/infix.awk" > "$nw_work/stages"
}

nw_run_stage() (
    # infix.awk permits only simple words, escapes and quotes. Split words
    # as the native shell does, with filename expansion disabled.
    set -f
    eval "set -- $1"
    nw_infix_native=yes
    nw_at_stage "$@"
)

nw_run_infix() {
    IFS= read -r nw_stage <&3 || return 2
    nw_input=
    while IFS= read -r nw_next <&3; do
        if [ -z "$nw_input" ]; then nw_run_stage "$nw_stage" 3<&- > "$nw_work/next" || return
        else nw_run_stage "$nw_stage" 3<&- < "$nw_input" > "$nw_work/next" || return; fi
        nw_input=$nw_work/previous
        mv -f "$nw_work/next" "$nw_input" || return
        nw_stage=$nw_next
    done
    nw_run_stage "$nw_stage" 3<&- < "$nw_input"
}

nw_operation=
while [ "$#" -gt 0 ]; do
    case $1 in
        -h|--help) nw_usage; exit ;;
        -m|--mode|-n|--nitpick|--effort|--permission)
            [ "$#" -ge 2 ] || nw_fail "$1 needs a value"
            case $1 in
                -m|--mode) nw_mode=$2 ;;
                -n|--nitpick) nw_strictness=$2 ;;
                --effort) nw_effort=$2 ;;
                --permission) nw_permission=$2 ;;
            esac
            shift 2 ;;
        --mode=*) nw_mode=${1#*=}; shift ;;
        --nitpick=*) nw_strictness=${1#*=}; shift ;;
        --effort=*) nw_effort=${1#*=}; shift ;;
        --permission=*) nw_permission=${1#*=}; shift ;;
        -c|-lc|--check|--link|--turn|--native) nw_operation=$1; shift; break ;;
        --) nw_operation=prose; shift; break ;;
        *) break ;;
    esac
done
nw_check_settings
if [ "$nw_language" = shn ]; then
    . "$nw_share/speech.sh"
    speech_setup
fi

case $nw_operation in
    --turn)
        [ "$#" -gt 0 ] || nw_fail 'expected a request'
        nw_agent "$nw_primer" "$@"; exit ;;
    --native)
        [ "$#" -gt 0 ] && [ -r "$1" ] || nw_fail 'expected readable native source'
        case $nw_language in
            nsh) exec "$nw_shell" "$@" ;;
            nhs) exec "$nw_python" "$@" ;;
            shn) speech_program "$1" no 0 3< "$1"; exit ;;
        esac ;;
    --check)
        [ "$#" -eq 1 ] && [ -r "$1" ] || nw_fail 'expected one readable source file'
        nw_native_check "$1"; exit ;;
    --link)
        [ "$#" -eq 2 ] && [ -r "$2" ] || nw_fail 'expected a name and a readable source file'
        nw_link "$1" "$2"; exit ;;
    prose)
        [ "$nw_strictness" != 2 ] || nw_fail 'prose is unavailable at nitpick level 2'
        [ "$nw_mode" != l ] || nw_fail 'use --link NAME FILE'
        if [ "$nw_name" = @ ]; then nw_one_shot @ "$@"; else nw_one_shot "$nw_primer" "$@"; fi
        exit ;;
esac

if [ "$nw_name" = @ ] && [ -z "$nw_operation" ] && [ "$#" -gt 0 ]; then
    [ "$nw_strictness" != 2 ] || nw_fail 'use -c for native shell source'
    [ "$nw_mode" != l ] || nw_fail 'use --link NAME FILE'
    nw_at "$@"
    exit
fi
if [ "$nw_mode" = l ] && { [ "$#" -ne 0 ] || [ -n "$nw_operation" ]; }; then
    nw_fail 'use --link NAME FILE'
fi

if [ "$nw_name" = @ ] && [ "$#" -eq 0 ] && [ -z "$nw_operation" ] &&
    { [ ! -t 0 ] || [ ! -t 1 ]; }; then
    printf '%s\n' 'α | Ω'
    exit
fi

if [ "$#" -gt 0 ] || [ -n "$nw_operation" ] || [ ! -t 0 ]; then
    if [ "$nw_strictness" = 2 ]; then
        case $nw_language in
            nsh) if [ -n "$nw_operation" ]; then set -- "$nw_operation" "$@"; fi
                 exec lord-run "$nw_shell" "$@" ;;
            nhs) if [ -n "$nw_operation" ]; then set -- -c "$@"; fi
                 exec lord-run "$nw_python" "$@" ;;
        esac
    fi
    nw_temp
    nw_line_mode=no
    if [ "$nw_operation" = -c ] || [ "$nw_operation" = -lc ]; then
        [ "$#" -gt 0 ] || nw_fail "$nw_operation needs source"
        nw_line=$1; shift
        if [ "$nw_language" = nsh ] && nw_infix "$nw_line"; then
            if [ "$nw_mode" = r ]; then nw_run_infix 3< "$nw_work/stages"
            else nw_one_shot @ "$nw_line" "$@"; fi
            exit
        fi
        nw_source=$nw_work/source
        printf '%s\n' "$nw_line" > "$nw_source"
        nw_line_mode=yes
    elif [ "$#" -gt 0 ]; then
        nw_source=$1; shift
        [ -f "$nw_source" ] && [ -r "$nw_source" ] || nw_fail "cannot read $nw_source"
        case $nw_source in -*) nw_source=./$nw_source ;; esac
    else
        nw_source=$nw_work/source
        cat > "$nw_source" || exit
        exec </dev/null
    fi

    nw_native=yes
    if [ "$nw_language" = nhs ] && ! command -v "$nw_python" >/dev/null 2>&1; then
        printf '%s: Python is unavailable (%s)\n' "$nw_name" "$nw_python" > "$nw_work/error"
        nw_native=no
    elif ! nw_native_check "$nw_source" 2> "$nw_work/error"; then
        nw_native=no
    fi
    nw_status=65
    if [ "$nw_native" = yes ]; then
        nw_status=0
        if [ "$nw_line_mode" = yes ]; then
            case $nw_language in
                nsh) nw_record "$nw_shell" "$nw_operation" "$nw_line" "$@" || nw_status=$? ;;
                nhs) nw_record "$nw_python" -c "$nw_line" "$@" || nw_status=$? ;;
                shn) nw_native_run "$nw_source" "$@" || nw_status=$? ;;
            esac
        else
            nw_native_run "$nw_source" "$@" || nw_status=$?
        fi
        case "$nw_strictness:$nw_language:$nw_status" in
            *:*:0|2:*:*|1:nsh:126|1:nsh:127) ;;
            1:*:*) exit "$nw_status" ;;
        esac
        [ "$nw_status" -ne 0 ] || exit 0
        [ "$nw_strictness" != 2 ] || exit "$nw_status"
    else
        cat "$nw_work/error" >&2
        [ "$nw_strictness" != 2 ] || exit "$nw_status"
    fi
    # Pin the diagnostic to this invocation even when other commands finish
    # in the same journal.
    nw_run_id=
    if [ -s "$nw_work/run-id" ]; then
        IFS= read -r nw_run_id < "$nw_work/run-id"
        lord-log stderr "$nw_run_id" | tail -c 4096 > "$nw_work/error"
    fi
    set -- "Native exit: $nw_status. Source: $nw_source${nw_run_id:+. Record: $nw_run_id}" \
        "$(tail -c 4096 "$nw_work/error")" "$(head -c 32768 "$nw_source")" "$@"
    if [ -n "$nw_run_id" ] && [ ! -t 0 ]; then
        nw_record_path=$(lord-log path "$nw_run_id") || exit
        if [ -s "$nw_record_path/stdin" ]; then
            cat "$nw_record_path/stdin" - | nw_one_shot "$nw_primer" "$@"
            exit
        fi
    fi
    nw_one_shot "$nw_primer" "$@"
    exit
fi

if [ "$nw_language" = nsh ]; then
    if [ -z "${NSH_SHELL:-}" ]; then nw_shell=$(command -v bash) || nw_shell=sh; fi
    if [ "$nw_shell" != sh ] && [ "${NW_IN_SHELL:-0}" != 1 ]; then
        NW_IN_SHELL=1 NW_MODE=$nw_mode NW_NITPICK=$nw_strictness LORD_PERMISSION=$nw_permission LORD_EFFORT=$nw_effort \
            exec "$nw_shell" "$0"
    fi
    unset NW_IN_SHELL
fi

nw_temp
if [ "$nw_language" = nhs ] && command -v "$nw_python" >/dev/null 2>&1; then
    export NW_MODE=$nw_mode NW_NITPICK=$nw_strictness LORD_PERMISSION=$nw_permission LORD_EFFORT=$nw_effort
    "$nw_python" "$nw_share/python.py" "$nw_bin/$nw_name"
    exit
fi
. "$nw_share/repl.sh"
