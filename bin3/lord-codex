#!/bin/sh
set -eu
case "$LORD_PERMISSION" in
    text|read) sandbox=read-only ;;
    write) sandbox=workspace-write ;;
    *) printf '%s\n' 'lord-codex: invalid permission' >&2; exit 2 ;;
esac

# TOML string escaping for instructions. Feed the request via argv and leave
# stdin intact for the CLI's own input handling.
request=$*
set -- exec --ephemeral --skip-git-repo-check --color never --sandbox "$sandbox" \
    --ignore-user-config --disable apps --disable plugins --disable hooks --disable computer_use \
    -c 'mcp_servers={}' -c 'web_search="disabled"' -c 'approval_policy="never"' \
    -c 'sandbox_workspace_write.network_access=false' -c "model_reasoning_effort=\"$LORD_EFFORT\""
if [ "$LORD_PERMISSION" = text ]; then
    set -- "$@" --disable shell_tool --disable view_image --disable multi_agent --disable multi_agent_v2 \
        -c 'project_doc_max_bytes=0'
fi
if [ -n "$LORD_PROGRAM" ]; then
    instructions=$(awk '{
        if (NR > 1) printf "\\n"
        for (i = 1; i <= length($0); i++) {
            c = substr($0, i, 1)
            if (c == "\\" || c == "\"") printf "\\%s", c
            else if (c == "\t") printf "\\t"
            else if (c == "\r") printf "\\r"
            else if (c == "\b") printf "\\b"
            else if (c == "\f") printf "\\f"
            else printf "%s", c
        }
    }' "$LORD_PROGRAM")
    set -- "$@" -c "developer_instructions=\"$instructions\""
fi
model=${LORD_MODEL:-}
if [ "$LORD_RUNNER" = law ]; then model=${LORD_FAST_MODEL:-$model}; fi
if [ -n "$model" ]; then set -- "$@" --model "$model"; fi
exec "${LORD_CODEX:-${GEN_CODEX:-codex}}" "$@" -- "$request"
