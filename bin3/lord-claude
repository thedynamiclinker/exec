#!/bin/sh
set -eu
[ "$LORD_PERMISSION" = text ] || {
    printf '%s\n' 'lord-claude: supports text permission only' >&2
    exit 2
}
effort=$LORD_EFFORT
if [ "$effort" = none ]; then effort=low; fi
request=$*
set -- --print --no-session-persistence --safe-mode --strict-mcp-config \
    --tools '' --disallowedTools 'mcp__*' --effort "$effort"
if [ -n "$LORD_PROGRAM" ]; then set -- "$@" --append-system-prompt-file "$LORD_PROGRAM"; fi
if [ -n "${LORD_MODEL:-}" ]; then set -- "$@" --model "$LORD_MODEL"; fi
DISABLE_AUTOUPDATER=1 exec "${LORD_CLAUDE:-claude}" "$@" -- "$request"
