#!/bin/sh
set -eu
# A gen filter receives a single prompt. Other backends can keep argv and
# stdin separate by implementing the lord backend interface directly.
if [ "$LORD_PERMISSION" != text ]; then
    printf '%s\n' 'lord-gen: supports text permission only' >&2
    exit 2
fi
{
    if [ -n "$LORD_PROGRAM" ]; then cat "$LORD_PROGRAM"; printf '\n'; fi
    printf '\nRequest:\n%s\n' "$*"
    if [ ! -t 0 ]; then printf '\nInput:\n'; cat; fi
} | if [ -n "${GEN_AGENT:-}" ]; then
    GEN_EFFORT=$LORD_EFFORT exec "$GEN_AGENT"
else
    exec gen ask "$LORD_EFFORT"
fi
