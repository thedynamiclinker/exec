#!/bin/sh
# Record one command while forwarding its three streams.
set -eu

id_file=
if [ "${1:-}" = --id-file ]; then
    [ "$#" -ge 2 ] || { printf '%s\n' 'lord-run: --id-file needs a path' >&2; exit 2; }
    id_file=$2
    shift 2
fi
if [ "${1:-}" = -- ]; then shift; fi
if [ "$#" -eq 0 ]; then
    printf '%s\n' 'usage: lord-run [--id-file FILE] [--] COMMAND [ARG ...]' >&2
    exit 2
fi
if [ -n "$id_file" ]; then (umask 077; : > "$id_file"); fi
if [ "${LORD_RECORD:-1}" = 0 ]; then exec "$@"; fi

caller_umask=$(umask)
umask 077
journal=${LORD_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/lord}
mkdir -p "$journal"
record=$(mktemp -d "$journal/run.XXXXXXXX")
id=${record##*/}
input_pid= output_pid= error_pid= pointer=
cleanup() {
    for pid in "$input_pid" "$output_pid" "$error_pid"; do
        [ -z "$pid" ] || kill "$pid" 2>/dev/null || :
    done
    [ -z "$pointer" ] || rm -f "$pointer"
    if [ ! -f "$record/status" ]; then rm -rf "$record"; fi
}
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

date -u '+%Y-%m-%dT%H:%M:%SZ' > "$record/started"
pwd -P > "$record/cwd"
printf '%s\n' "${LORD_RUNNER:-}" > "$record/runner"
printf '%s\n' "${LORD_EFFORT:-}" > "$record/effort"
printf '%s\n' "${LORD_PERMISSION:-}" > "$record/permission"
printf '%s\n' "${LORD_PROGRAM:-}" > "$record/program"
printf '%s\0' "$@" > "$record/argv"
: > "$record/stdin"
: > "$record/stdout"
: > "$record/stderr"
mkfifo "$record/out.pipe" "$record/err.pipe"

# Keep the caller's umask for the command. Journal bytes are always private
# through the containing directory, including when a tee creates a file.
tee "$record/stdout" < "$record/out.pipe" &
output_pid=$!
tee "$record/stderr" < "$record/err.pipe" >&2 &
error_pid=$!

status=0
if [ -t 0 ]; then
    printf '%s\n' terminal > "$record/input"
    (umask "$caller_umask"; exec "$@") > "$record/out.pipe" 2> "$record/err.pipe" || status=$?
else
    printf '%s\n' stream > "$record/input"
    mkfifo "$record/in.pipe"
    # An explicit descriptor keeps asynchronous lists from receiving /dev/null.
    exec 3<&0
    tee "$record/in.pipe" <&3 3<&- > "$record/stdin" 2>/dev/null &
    input_pid=$!
    (umask "$caller_umask"; exec "$@") < "$record/in.pipe" > "$record/out.pipe" 2> "$record/err.pipe" 3<&- || status=$?
    exec 3<&-
    # A command may finish before the upstream producer sends EOF.
    kill "$input_pid" 2>/dev/null || :
    wait "$input_pid" 2>/dev/null || :
    input_pid=
    rm "$record/in.pipe"
fi
wait "$output_pid" || :
output_pid=
wait "$error_pid" || :
error_pid=
rm "$record/out.pipe" "$record/err.pipe"
date -u '+%Y-%m-%dT%H:%M:%SZ' > "$record/finished"
printf '%s\n' "$status" > "$record/.status"
mv "$record/.status" "$record/status"
pointer=$(mktemp "$journal/.latest.XXXXXXXX")
printf '%s\n' "$id" > "$pointer"
mv -f "$pointer" "$journal/latest"
pointer=
if [ -n "$id_file" ]; then printf '%s\n' "$id" > "$id_file"; fi
exit "$status"
