#!/usr/bin/env bash

set -euo pipefail

exec_root="${EXEC:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)}"

verbose=0
quiet=0
echo_only=0
use_agents=1
created_agents=0
profile="${LORD_PROFILE:-}"
prose_args=0
literal_args=0
effort=medium
flags=()
prompt_args=()
stages=()
lock_dir=
chat_dir=

usage() {
    cat <<'EOF'
usage: lord [options] [@mode] [prompt ...]
       lord [options] stage @ stage [@ stage ...]

Run codex exec with an AGENTS profile:

  @repo    code/repository work. Default inside a Git worktree.
  @unix    Unix-filter work. Default outside a Git worktree.
  @book    long-form explanation, exegesis, and careful reading.
  @chat    answer a question without touching the current worktree.
  @@       run English as the @ program. Arguments after @@ are the request.
           With no arguments on a terminal, enter the New Human Shell.

If ./AGENTS.md is a real local file, lord leaves it alone and Codex reads it.
Repo and book modes may replace lord's own profile links.

A bare @ passes the result of one semantic stage to the next. Pipelines
default to Unix mode, and only the final result goes to stdout.

Options:
  -h, --help            show this help
  -v, --verbose         show wrapper behavior and stream codex output
  -q, --quiet           capture codex output, even in verbose-by-default modes
  -f, --force           pass --dangerously-bypass-approvals-and-sandbox
      --effort LEVEL    set reasoning effort 0..5 or none through max
                        none requires a model that supports it
      --fast            same as --effort low
      --careful         same as --effort high
      --xhigh           same as --effort xhigh
      --no-agents       do not install an AGENTS.md profile
      --profile NAME    select profile by name: repo, unix, book, chat, @
      --                stop option parsing

@options:
  @repo, @unix, @book,
  @chat                select mode
  @profile=NAME        select profile by name
  @no-agents           do not install an AGENTS.md profile
  @echo                print the codex exec command instead of running it
  @effort=LEVEL        set reasoning effort
  @fast, @careful,
  @xhigh               effort shorthands
  @FLAG                pass --FLAG to codex exec

Sandbox:
  In a Git worktree, lord adds -s workspace-write, except for @chat.
  Unix mode also gets workspace-write, even outside Git.
  Chat mode uses read-only, ephemeral Codex execution in a temporary directory.

Read recorded command streams with lord-log. LORD_RECORD=0 runs directly.
EOF
}

in_git_repo() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1
}

log() {
    if ((verbose)); then
        printf 'lord: %s\n' "$*" >&2
    fi
}

cleanup() {
    if ((created_agents)); then
        rm -f AGENTS.md
    fi
    if [[ -n "$lock_dir" ]]; then
        rmdir -- "$lock_dir" 2>/dev/null || true
    fi
    if [[ -n "$chat_dir" ]]; then
        rm -rf -- "$chat_dir"
    fi
}

set_effort() {
    case "$1" in
        0|none) effort=none ;;
        1|low) effort=low ;;
        2|medium) effort=medium ;;
        3|high) effort=high ;;
        4|xhigh) effort=xhigh ;;
        5|max) effort=max ;;
        *)
            printf 'lord: unknown effort: %s\n' "$1" >&2
            printf 'lord: expected one of: none low medium high xhigh max\n' >&2
            exit 2
            ;;
    esac
}

canonical_profile() {
    case "$1" in
        @) printf '%s\n' @ ;;
        repo|git|code) printf '%s\n' repo ;;
        unix|command|unix-command|filter) printf '%s\n' unix ;;
        book|bible|nameless|we-the-nameless) printf '%s\n' book ;;
        chat|ask|question|qa) printf '%s\n' chat ;;
        "")
            printf 'lord: empty profile name\n' >&2
            exit 2
            ;;
        *)
            printf 'lord: unknown profile: %s\n' "$1" >&2
            printf 'lord: expected one of: repo unix book chat @\n' >&2
            exit 2
            ;;
    esac
}

select_profile() {
    profile="$(canonical_profile "$1")"
    if [[ "$profile" == @ ]]; then
        prose_args=1
    fi
}

profile_file() {
    if [[ "$profile" == @ && -n "${NSH_PROGRAM:-}" ]]; then
        printf '%s\n' "$NSH_PROGRAM"
        return
    fi
    printf '%s/etc/lord/AGENTS-%s.md\n' "$exec_root" "$profile"
}

profile_uses_agents() {
    [[ "$profile" == repo || "$profile" == book ]]
}

agents_link_is_ours() {
    local link target abs_target

    [[ -L AGENTS.md ]] || return 1

    link="$(readlink -- AGENTS.md)" || return 1
    case "$link" in
        /*) target="$link" ;;
        *) target="$PWD/$link" ;;
    esac

    abs_target="$(realpath -m -- "$target")"
    [[ "$abs_target" == "$exec_root"/etc/lord/AGENTS-*.md ]]
}

real_local_agents_exists() {
    [[ -e AGENTS.md || -L AGENTS.md ]] && ! agents_link_is_ours
}

parse_option() {
    case "$1" in
        -h|--help)
            usage
            exit
            ;;
        -v|--verbose)
            verbose=1
            ;;
        -q|--quiet)
            quiet=1
            ;;
        -f|--force|--dont-panic)
            flags+=( --dangerously-bypass-approvals-and-sandbox )
            ;;
        --no-agents|@no-agents)
            use_agents=0
            ;;
        @echo)
            echo_only=1
            ;;
        @yhwh)
            use_agents=0
            flags+=( --skip-git-repo-check )
            ;;
        --fast|@fast|--quick|@quick)
            set_effort low
            ;;
        --careful|@careful|--accurate|@accurate)
            set_effort high
            ;;
        --xhigh|@xhigh|--very-careful|@very-careful)
            set_effort xhigh
            ;;
        @repo|@unix|@book|@chat)
            select_profile "${1#@}"
            ;;
        @profile=*|@agents=*|@pray=*)
            select_profile "${1#*=}"
            ;;
        @effort=*|@thinking=*)
            set_effort "${1#*=}"
            ;;
        @?*)
            flags+=( "--${1#@}" )
            ;;
        *)
            return 1
            ;;
    esac
}

while (($#)); do
    if ((prose_args)) || [[ "$1" == @@ ]]; then
        if [[ "$1" == @@ ]]; then
            profile=@
            shift
        fi
        if [[ "${1:-}" == -- ]]; then
            literal_args=1
            shift
        fi
        prompt_args+=( "$@" )
        break
    fi
    case "$1" in
        @)
            if ((${#prompt_args[@]} == 0)); then
                printf 'lord: expected a stage before @\n' >&2
                exit 2
            fi
            stages+=( "${prompt_args[*]}" )
            prompt_args=()
            shift
            continue
            ;;
        --)
            literal_args=1
            shift
            prompt_args+=( "$@" )
            break
            ;;
        --effort|--thinking)
            if (($# < 2)); then
                printf 'lord: %s needs an argument\n' "$1" >&2
                exit 2
            fi
            set_effort "$2"
            shift 2
            continue
            ;;
        --effort=*|--thinking=*)
            set_effort "${1#*=}"
            shift
            continue
            ;;
        --profile|--agents)
            if (($# < 2)); then
                printf 'lord: %s needs an argument\n' "$1" >&2
                exit 2
            fi
            select_profile "$2"
            shift 2
            continue
            ;;
        --profile=*|--agents=*)
            select_profile "${1#*=}"
            shift
            continue
            ;;
    esac

    if parse_option "$1"; then
        shift
    else
        prompt_args+=( "$1" )
        shift
    fi
done

if ((${#stages[@]})); then
    if ((${#prompt_args[@]} == 0)); then
        printf 'lord: expected a stage after @\n' >&2
        exit 2
    fi
    profile="${profile:-unix}"
fi

git_repo=0
if in_git_repo; then
    git_repo=1
fi

if [[ -n "$profile" ]]; then
    profile="$(canonical_profile "$profile")"
elif real_local_agents_exists; then
    profile=
elif ((git_repo)); then
    profile=repo
else
    profile=unix
fi

if ((quiet)); then
    verbose=0
elif [[ "$profile" != unix && "$profile" != @ ]]; then
    verbose=1
fi

if [[ "$profile" == chat ]]; then
    flags+=( --skip-git-repo-check --ephemeral -s read-only )
elif [[ "$profile" == @ && "${NSH_TURN:-}" == 1 ]]; then
    flags+=( --skip-git-repo-check --ephemeral -s workspace-write --add-dir "${NSH_HOME:?}" )
elif ((git_repo)); then
    flags+=( --skip-git-repo-check -s workspace-write )
elif [[ "$profile" == unix ]]; then
    flags+=( --skip-git-repo-check -s workspace-write )
else
    flags+=( --skip-git-repo-check )
fi

install_agents() {
    local target

    if ! profile_uses_agents; then
        return 0
    fi

    if ! ((use_agents)); then
        if agents_link_is_ours; then
            rm -f AGENTS.md
        fi
        return 0
    fi

    [[ -n "$profile" ]] || return 0

    if real_local_agents_exists; then
        log "using real local AGENTS.md"
        return 0
    fi

    target="$(profile_file)"
    if [[ ! -f "$target" ]]; then
        printf 'lord: missing profile file: %s\n' "$target" >&2
        exit 1
    fi

    if agents_link_is_ours; then
        rm -f AGENTS.md
    fi

    ln -s -- "$target" AGENTS.md
    created_agents=1
    trap cleanup EXIT INT TERM HUP
    log "linked AGENTS.md -> $target"
}

lock_worktree_agents() {
    local i
    if [[ -z "$profile" ]] || ! profile_uses_agents; then
        return 0
    fi

    lock_dir=".lord-agents.lock"

    for i in {1..100}; do
        if mkdir -- "$lock_dir" 2>/dev/null; then
            trap cleanup EXIT INT TERM HUP
            return 0
        fi
        sleep 0.1
    done

    printf 'lord: timed out waiting for %s\n' "$lock_dir" >&2
    exit 1
}

run_backend() {
    local recorder="${LORD_RECORDER:-}" permission=default flag previous= program=
    if [[ -z "$recorder" ]]; then
        recorder=$(command -v lord-run) ||
            recorder="$exec_root/../AT/dst/root/src/thedynamiclinker/lord/lord-run"
    fi
    if [[ "${LORD_RECORD:-1}" == 0 || ! -x "$recorder" ]]; then
        "$@"
    else
        for flag in "$@"; do
            case $flag in --) break ;; esac
            case $previous:$flag in
                -s:read-only|--sandbox:read-only|*:--sandbox=read-only) permission=read ;;
                -s:workspace-write|--sandbox:workspace-write|*:--sandbox=workspace-write) permission=write ;;
                -s:danger-full-access|--sandbox:danger-full-access|*:--sandbox=danger-full-access|*:--dangerously-bypass-approvals-and-sandbox) permission=unrestricted ;;
            esac
            previous=$flag
        done
        if ((use_agents)) && [[ -n "$profile" ]]; then program=$(profile_file); fi
        LORD_RUNNER="${LORD_LEGACY_RUNNER:-lord}" LORD_EFFORT="$effort" \
            LORD_PERMISSION="$permission" LORD_PROGRAM="$program" "$recorder" "$@"
    fi
}

run_quietly() (
    local capture latest status
    capture="$(mktemp -d)"
    trap 'rm -f -- "$capture/stdout" "$capture/stderr"; rmdir -- "$capture"' EXIT

    if run_backend "$@" >"$capture/stdout" 2>"$capture/stderr"; then
        if mkdir -p -- "$HOME/.cache/lord" &&
            latest="$(mktemp "$HOME/.cache/lord/$(date +%Y%m%d-%H%M%S.%3N).XXXXXX")"; then
            tee -- "$latest" < "$capture/stdout"
        else
            cat -- "$capture/stdout"
        fi
    else
        status=$?
        cat -- "$capture/stderr" >&2
        return "$status"
    fi
)

run() {
    local prompt="${prompt_args[*]}" stage instructions
    if ((${#stages[@]})); then
        prompt=$'Apply these text operations in order. Each @ feeds the preceding result into the next stage. If stdin is provided, it is input to the first stage. Interpret stage names by their meaning and return only the final result as plain text.\n\n'
        for stage in "${stages[@]}"; do
            prompt+="$stage"$'\n@\n'
        done
        prompt+="${prompt_args[*]}"
    fi

    if [[ "$profile" == @ || "$profile" == unix ]] && ((use_agents)); then
        # Pass the profile as a TOML string so filters can run in parallel.
        instructions="$(cat -- "$(profile_file)")" || return
        instructions=${instructions//\\/\\\\}
        instructions=${instructions//\"/\\\"}
        instructions=${instructions//$'\n'/\\n}
        instructions=${instructions//$'\r'/\\r}
        instructions=${instructions//$'\t'/\\t}
        instructions=${instructions//$'\b'/\\b}
        instructions=${instructions//$'\f'/\\f}
        flags+=( -c "developer_instructions=\"$instructions\"" )
    fi
    if [[ "$profile" == chat ]]; then
        chat_dir="$(mktemp -d "${TMPDIR:-/tmp}/lord-chat.XXXXXX")"
        flags+=( -C "$chat_dir" )
        prompt="$(cat -- "$(profile_file)")"$'\n\n'"$prompt"
        trap cleanup EXIT INT TERM HUP
    fi

    local cmd=( codex exec -c "model_reasoning_effort=\"$effort\"" "${flags[@]}" -- "$prompt" )

    if ((echo_only)); then
        printf '%q' "${cmd[0]}"
        printf ' %q' "${cmd[@]:1}"
        printf '\n'
        return
    fi

    log "running: ${cmd[*]}"

    if ((verbose)) || [[ "$profile" == @ && "${NSH_TURN:-}" == 1 ]]; then
        run_backend "${cmd[@]}"
    elif [[ "$profile" == @ && -t 0 && ! -t 1 ]]; then
        run_quietly "${cmd[@]}" </dev/null
    else
        run_quietly "${cmd[@]}"
    fi
}

if [[ "$profile" == @ && "${NSH_TURN:-}" != 1 ]] && ((!echo_only)); then
    if ((!literal_args)) && [[ "${prompt_args[0]:-}" == -c || "${prompt_args[0]:-}" == -lc ]]; then
        if ((${#prompt_args[@]} < 2)); then
            printf '@: -c needs a command line\n' >&2
            exit 2
        fi
        NSH_PROGRAM="$(profile_file)" exec "$exec_root/bin2/nsh" -c "${prompt_args[@]:1}"
    fi
    if [[ -t 0 && -t 1 ]] && ((${#prompt_args[@]} == 0)); then
        NSH_PROGRAM="$(profile_file)" exec "$exec_root/bin2/nsh"
    elif ((${#prompt_args[@]} == 0)); then
        prompt_args+=( @ )
    fi
fi

if ((!echo_only)); then
    lock_worktree_agents
    install_agents
fi
run
