#!/usr/bin/env bash

source "$(dirname "${BASH_SOURCE[0]}")/../lib/bash/git-objects.sh"

tags= status=0
while (($#)); do
    case $1 in
        -t|--tags) tags=1 ;;
        --) shift; break ;;
        -h|--help) echo 'usage: git cat [-t] REF/PATH | BLOB | PATH ...'; exit ;;
        *) break ;;
    esac
    shift
done

if (($# == 0)); then
    echo 'usage: git cat [-t] REF/PATH | BLOB | PATH ...' >&2
    exit 2
fi

if (($# == 2)) && rev=$(git_revision "$1") && git_object_at "$rev" "$2" && [[ $kind == blob ]]; then
    set -- "$object"
fi
while (($#)); do
    git_operand "$@"
    shift "$consumed"
    if git_object "$operand" && [[ $kind == blob ]]; then
        git cat-file blob "$object" || status=1
    else
        git_object_error "$operand" 'a blob'
        status=1
    fi
done
exit "$status"
