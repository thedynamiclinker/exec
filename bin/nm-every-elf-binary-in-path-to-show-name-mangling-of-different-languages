#!/usr/bin/env bash

remaining_path=$PATH
while :; do
    directory=${remaining_path%%:*}
    # Empty PATH entries refer to the current directory.
    directory=${directory:-.}

    for binary in "$directory"/* "$directory"/.[!.]* "$directory"/..?*; do
        [[ -f "$binary" && -x "$binary" ]] || continue

        case $(file -Lb -- "$binary") in
            ELF*)
                if nm -- "$binary"; then
                    printf 'That was: %s\n' "$binary"
                    read -r || exit 0
                fi
                ;;
        esac
    done

    [[ $remaining_path == *:* ]] || break
    remaining_path=${remaining_path#*:}
done
