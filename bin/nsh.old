#!/usr/bin/env bash

if [[ ${1:-} == --help ]]; then
    printf '%s\n' 'usage: nsh.old [-c LINE]' \
        'Run Bash commands or clarify a failed command with @.' \
        'Join simple semantic stages with a bare @. Use Readline to edit or recall a line.' \
        'Type :paste for multiple lines, ld.so COMMAND for plain Bash, or exit to leave.'
    exit
fi
if (($#)) && [[ "$1" != -c || $# -lt 2 ]]; then
    printf 'usage: nsh.old [-c LINE]\n' >&2
    exit 2
fi

nsh_root=${EXEC:-$(cd -- "$(dirname -- "$(realpath -- "$0")")/.." && pwd -P)}
NSH_PROGRAM=$(realpath -- "${NSH_PROGRAM:-$nsh_root/etc/lord/AGENTS-@.md.old}") || exit
NSH_HOME=$(realpath -m -- "${NSH_HOME:-$HOME/.nsh}") || exit
export NSH_PROGRAM NSH_HOME
(umask 077; mkdir -p -- "$NSH_HOME"/{etc,bin,lib}) || exit
PATH="$NSH_HOME/bin:$PATH"
export PATH

nsh_tmp=$(mktemp -d) || exit
trap 'rm -f -- "$nsh_tmp"/{stderr,context,reply,backend,input}; rmdir -- "$nsh_tmp"' EXIT
shopt -s expand_aliases
nsh_history=()
nsh_status=0
nsh_question=
nsh_bash=
nsh_block=0
nsh_interrupted=0
trap 'nsh_interrupted=1' INT

nsh_load_bash() {
    local file="$NSH_HOME/etc/nsh.bash" contents=
    if [[ -r "$file" ]]; then
        contents=$(<"$file")
        if [[ "$contents" != "$nsh_bash" ]]; then
            bash -n "$file" && source "$file" || return
        fi
    fi
    nsh_bash=$contents
}

# The escape works in pipelines and keeps normal terminal descriptors.
ld.so() { "$@"; }

nsh_reply() {
    local backend backend_status reply
    {
        printf 'New Human Shell turn\nDirectory: %q\nNSH_HOME: %q\n' "$PWD" "$NSH_HOME"
        printf 'Bash result: %s\n' "$nsh_result"
        if [[ -n "$nsh_diagnostic" ]]; then
            printf 'Bash stderr (last 4096 bytes):\n%s\n' "$nsh_diagnostic"
        fi
        if [[ -n "$nsh_question" ]]; then
            printf 'Pending question:\n%s\n' "${nsh_question:0:4096}"
        fi
        if [[ -s "$NSH_HOME/etc/nshrc" ]]; then
            printf 'Saved scope definitions from etc/nshrc (last 32768 bytes):\n'
            tail -c 32768 -- "$NSH_HOME/etc/nshrc"
            printf '\n'
        fi
        printf 'Recent turns, oldest first:\n'
        printf '%s\n' "${nsh_history[@]}"
    } > "$nsh_tmp/context"
    for backend in law.old lawd.old lord.old lordy.old lordhavemercy.old tetragrammaton.old; do
        type -P "$backend" >/dev/null || continue
        NSH_TURN=1 "$backend" @@ -- "$nsh_line" \
            < "$nsh_tmp/context" > "$nsh_tmp/reply" 2> "$nsh_tmp/backend"
        backend_status=$?
        if ((nsh_interrupted || backend_status == 130)); then
            nsh_question=
            return 130
        fi
        if ((backend_status)); then
            cat -- "$nsh_tmp/backend" >&2
            return "$backend_status"
        fi

        reply=$(<"$nsh_tmp/reply")
        case "$reply" in
            '@more') continue ;;
            $'@ask\n'?*)
                nsh_question=${reply#*$'\n'}
                nsh_answer=$nsh_question
                printf '%s\n' "$nsh_question" >&2
                return 2
                ;;
            $'@fail\n'?*)
                nsh_question=
                nsh_answer=${reply#*$'\n'}
                printf '%s\n' "$nsh_answer" >&2
                return 1
                ;;
        esac
        nsh_question=
        nsh_answer=$reply
        cat -- "$nsh_tmp/reply"
        nsh_load_bash || return
        hash -r
        return 0
    done
    printf 'nsh.old: no agent answered. What did you mean by %s?\n' "$nsh_line" >&2
    return 127
}

nsh_restore_status() { return "$1"; }

nsh_semantic_pipeline() (
    # Reserve @ between simple words. Leave Bash syntax and quoted @ alone.
    local literal="[^[:space:]'\"\\\\\`\$#&|;<>()]"
    local quoted="'[^']*'|\"([^\"\\\\\`\$]|\\\\.)*\""
    local word="($literal|$quoted|\\\\.)+"
    local stage="$word([[:blank:]]+$word)*"
    [[ "$nsh_line" =~ ^[[:blank:]]*$stage[[:blank:]]+@[[:blank:]]+$stage[[:blank:]]*$ ]]
)

nsh_turn() {
    nsh_result='not run'
    nsh_answer=
    nsh_diagnostic=
    : > "$nsh_tmp/stderr"
    if [[ "$nsh_line" == 'ld.so '* ]]; then
        nsh_restore_status "$nsh_status"
        eval -- "$nsh_line"
        nsh_status=$?
        nsh_result="exit $nsh_status"
    elif [[ -n "$nsh_question" ]] || { [[ "$nsh_line" == *@* ]] && nsh_semantic_pipeline; }; then
        nsh_reply
        nsh_status=$?
    else
        nsh_restore_status "$nsh_status"
        eval -- "$nsh_line" 2> "$nsh_tmp/stderr"
        nsh_status=$?
        nsh_result="exit $nsh_status"
        if ((nsh_interrupted || nsh_status == 130)); then
            cat -- "$nsh_tmp/stderr" >&2
            nsh_status=130
        elif ((nsh_status)) && { [[ -s "$nsh_tmp/stderr" ]] || ((nsh_status == 126 || nsh_status == 127)); }; then
            nsh_diagnostic=$(tail -c 4096 -- "$nsh_tmp/stderr")
            nsh_reply
            nsh_status=$?
            if [[ -z "$nsh_answer" && "$nsh_status" != 0 && "$nsh_status" != 130 ]]; then
                cat -- "$nsh_tmp/stderr" >&2
            fi
        elif [[ -s "$nsh_tmp/stderr" ]]; then
            cat -- "$nsh_tmp/stderr" >&2
        fi
    fi
    if ((nsh_interrupted)); then
        nsh_question=
        nsh_status=130
        nsh_interrupted=0
    fi
    local entry
    printf -v entry 'Input: %s\nBash: %s\nStatus: %s' "${nsh_line:0:4096}" "$nsh_result" "$nsh_status"
    if [[ -n "$nsh_diagnostic" ]]; then
        entry+=$'\n'"Stderr: ${nsh_diagnostic:0:1024}"
    fi
    if [[ -n "$nsh_answer" ]]; then
        entry+=$'\n'"Agent: ${nsh_answer:0:4096}"
    fi
    nsh_history+=( "$entry" )
    if ((${#nsh_history[@]} > 16)); then
        nsh_history=( "${nsh_history[@]: -16}" )
    fi
}

nsh_load_bash || exit
if [[ ${1:-} == -c ]]; then
    nsh_line=$2
    shift 2
    if (($#)); then
        BASH_ARGV0=$1
        shift
    fi
    nsh_turn "$@"
    exit "$nsh_status"
fi

nsh_terminal=0
if [[ -t 0 ]]; then
    nsh_terminal=1
    nsh_readline=-e
    if ((BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 3))); then
        nsh_readline=-E
    fi
    nsh_history_file="$NSH_HOME/history"
    if (umask 077; : >> "$nsh_history_file"); then
        shopt -s cmdhist lithist
        HISTTIMEFORMAT=${HISTTIMEFORMAT:-'%F %T '}
        history -r "$nsh_history_file"
    else
        nsh_history_file=
    fi
fi

while :; do
    nsh_primary="$PWD @ "
    case "$PWD" in
        "$HOME"|"$HOME/"*) nsh_primary="~${PWD#"$HOME"} @ " ;;
    esac
    nsh_continue='> '
    if [[ ${NSH_STYLE:-} == nhs ]]; then
        nsh_primary='>>> '
        nsh_continue='... '
    fi
    nsh_prompt=$nsh_primary
    ((nsh_block == 0)) || nsh_prompt=$nsh_continue
    nsh_input=
    if ((nsh_terminal)); then
        nsh_tty=$(stty -g)
        # A trapped interrupt resumes Bash's read. Exit only the reader so
        # Ctrl+C discards its buffer and the parent keeps the shell state.
        (
            trap 'exit 130' INT
            IFS= read "$nsh_readline" -r -p "$nsh_prompt" nsh_input
            nsh_read=$?
            printf '%s' "$nsh_input" > "$nsh_tmp/input"
            exit "$nsh_read"
        )
        nsh_read=$?
        if ((nsh_read != 130 && ! nsh_interrupted)); then
            IFS= read -r -d '' nsh_input < "$nsh_tmp/input"
        else
            [[ -z "$nsh_tty" ]] || stty "$nsh_tty"
            printf '\n' >&2
        fi
    else
        IFS= read -r nsh_input
        nsh_read=$?
    fi
    if ((nsh_read == 130 || nsh_interrupted)); then
        nsh_question=
        nsh_line=
        nsh_block=0
        nsh_interrupted=0
        nsh_status=130
        continue
    fi

    if ((nsh_block)); then
        if [[ -n "$nsh_input" ]]; then
            nsh_line+=${nsh_line:+$'\n'}"$nsh_input"
            ((nsh_read)) || continue
        fi
        nsh_block=0
    else
        nsh_line=$nsh_input
        if ((nsh_read == 0)) && [[ "$nsh_line" == :paste || ( "$nsh_line" == *: && ( ${NSH_STYLE:-} == nhs || -n "$nsh_question" ) ) ]]; then
            [[ "$nsh_line" != :paste ]] || nsh_line=
            nsh_block=1
            continue
        fi
    fi
    if [[ -n "$nsh_line" ]]; then
        if ((nsh_terminal)) && [[ "$nsh_line" != ' '* ]]; then
            history -s -- "$nsh_line"
            [[ -z "$nsh_history_file" ]] || history -a "$nsh_history_file"
        fi
        nsh_turn
    fi
    ((nsh_read == 0)) || break
done
exit "$nsh_status"
