#!/usr/bin/env bash

red='\033[01;31m'
blu='\033[01;34m'
whi='\033[01;39m'
end='\033[00m'

die   () { printf "${red}ERROR${whi}: %s${end}\n" "$1" >&2; exit 1; }
log   () { printf "${blu}[${whi}*${blu}]${whi} ${1}${end}\n"; }

usage () {
    # We can optionally pass in an explanation of what went wrong.
    [[ -n "$1" ]] && log "${1}"
    cat << EOF
USAGE
    $(basename $0) [OPTIONS]
OPTIONS
    --english,          -E          Switch input method to English
    --chinese,          -C          Switch input method to Chinese
    --japanese,         -J          Switch input method to Japanese
    --korean,           -K          Switch input method to Korean
    --devangari,        -D          Switch input method to Devangari
    --telugu,           -T          Switch input method to Telugu
    --hebrew,           -H          Switch input method to Hebrew
    --arabic,           -A          Switch input method to Arabic
    --russian,          -R          Switch input method to Russian
    --greek,            -G          Switch input method to Greek

    --start,            -i, on, +   Start IBus daemon
    --stop,             -o, off, -  Stop IBus daemon
    --setup,            -s          Open graphical setup window for input methods.
    --kill-gtk-ui,      -x          Kill the GTK UI of a currently running IBus daemon
    --minimal,          -m          Start IBus daemon & kill GTK UI. Workaround for Cinnamon Bug.
    --help,             -h          Show this help
EOF
    exit 1
}

declare -A IM
IM=(
    [ENG]="xkb:us::eng"
    [CHI]="libpinyin"
    [JAP]="anthy"
    [KOR]="hangul"
    [ARA]="xkb:ara:mac-phonetic:ara"
    [HEB]="xkb:il:phonetic:heb"
    [DEV]="xkb:in:hin-kagapa:hin"
    [TEL]="xkb:in:tel-kagapa:tel"
    [RUS]="xkb:ru:phonetic:rus"
    [GRE]="xkb:gr::ell"
)

### HELPER FUNCTIONS ###

__ibus_is_running () {
    ibus list-engine --name-only &>/dev/null
}

in_cinnamon () {
    case ":${XDG_CURRENT_DESKTOP,,}:" in
        *:x-cinnamon:*|*:cinnamon:*) return 0;;
        *) return 1;;
    esac
}

### INPUT METHOD SWITCHER FUNCTIONS ###

cinnamon_call () {
    local method=$1
    shift
    gdbus call --session --timeout 5 --dest org.Cinnamon \
        --object-path /org/Cinnamon --method "org.Cinnamon.$method" "$@"
}

ibus_has_engine () {
    ibus list-engine --name-only 2>/dev/null | grep -Fx -- "$1" >/dev/null
}

cinnamon_switch () (
    local engine=$1 type=ibus id=$1 layout variant sources configured source attempt
    local schema=org.cinnamon.desktop.input-sources

    # Cinnamon changes the XKB keymap itself for these sources.
    if [[ $engine == xkb:* ]]; then
        IFS=: read -r type layout variant _ <<< "$engine"
        id=$layout${variant:+"+$variant"}
    fi

    exec 9>"${XDG_RUNTIME_DIR:?}/im.lock" || return
    flock 9 || return

    sources=$(cinnamon_call GetInputSources) || return
    if [[ $sources =~ "('$type', '$id', "([0-9]+), ]]; then
        cinnamon_call ActivateInputSourceIndex "${BASH_REMATCH[1]}" >/dev/null
        return
    fi

    if [[ $type == ibus ]] && ! ibus_has_engine "$engine"; then
        # An IBus daemon started without the NixOS components can miss CJK engines.
        ibus_launch --replace --cache=refresh || return
        for ((attempt = 0; attempt < 40; attempt++)); do
            ibus_has_engine "$engine" && break
            sleep 0.1
        done
        ((attempt < 40)) || die "IBus engine unavailable: $engine"
    fi

    configured=$(gsettings get "$schema" sources) || return
    source="('$type', '$id')"
    if [[ $configured != *"$source"* ]]; then
        configured=${configured#'@a(ss) '}
        configured=${configured%]}
        [[ $configured == '[' ]] || configured+=', '
        gsettings set "$schema" sources "$configured$source]" || return
    fi

    # Wait for Cinnamon to rebuild its list before choosing the source index.
    for ((attempt = 0; attempt < 40; attempt++)); do
        sources=$(cinnamon_call GetInputSources) || return
        if [[ $sources =~ "('$type', '$id', "([0-9]+), ]]; then
            cinnamon_call ActivateInputSourceIndex "${BASH_REMATCH[1]}" >/dev/null
            return
        fi
        sleep 0.1
    done
    die "Cinnamon input source unavailable: $id"
)

switch_to () {
    local language=$1 engine=${IM[$2]}
    log "Switching input method to $language: $engine"
    if in_cinnamon; then
        cinnamon_switch "$engine"
    else
        ibus_start && ibus engine "$engine"
    fi
}


### IBUS CONTROL FUNCTIONS ###

ibus_launch () {
    local -a options=(--daemonize)
    local components=/run/current-system/sw/share/ibus/component

    if in_cinnamon; then
        options+=(--desktop=cinnamon --panel=disable)
    fi
    if [[ -n $DISPLAY && -z $WAYLAND_DISPLAY ]]; then
        options+=(--xim)
    fi
    if [[ -z $IBUS_COMPONENT_PATH && -d $components ]]; then
        export IBUS_COMPONENT_PATH=$components
    fi

    log "Starting ibus"
    ibus-daemon "${options[@]}" "$@" 9>&-
}

ibus_start () {
    local attempt

    __ibus_is_running && return
    ibus_launch || return
    for ((attempt = 0; attempt < 40; attempt++)); do
        __ibus_is_running && return
        sleep 0.1
    done
    die "Timed out waiting for IBus"
}

ibus_stop () {
    if __ibus_is_running; then
        log "Killing ibus-daemon"
        switch_to English ENG
        ibus exit
    else
        log "IBus is not running."
    fi
}

ibus_kill_gtk_ui () {
    killall -r ibus-ui-gtk3
}

ibus_start_minimal () {
    log "Starting ibus and killing the GTK UI"
    ibus_start || return
    if pgrep -u "$UID" -x ibus-ui-gtk3 >/dev/null; then
        ibus_kill_gtk_ui
    fi
}

ibus_restart () {
    if __ibus_is_running; then
        log "Restarting ibus-daemon"
        if in_cinnamon; then
            ibus_launch --replace --cache=refresh
        else
            ibus restart
        fi
    else
    log "Restart requested, but ibus not running. Starting cold."
        ibus_start
    fi
}

ibus_setup () {
    log "Opening ibus-setup. Warning, this might fuck with Cinnamon until we kill iBus."
    ibus-setup
}


[[ -z "$1" ]] && usage

while [[ -n "$1" ]]; do
    case "$1" in

        --english|-E|E)         switch_to English ENG;;
        --japanese|-J|J)        switch_to Japanese JAP;;
        --chinese|-C|C)         switch_to Chinese CHI;;
        --korean|-K|K)          switch_to Korean KOR;;
        --hebrew|-H|H)          switch_to Hebrew HEB;;
        --arabic|-A|A)          switch_to Arabic ARA;;
        --devangari|-D|D)       switch_to Devanagari DEV;;
        --telugu|-T|T)          switch_to Telugu TEL;;
        --russian|-R|R)         switch_to Russian RUS;;
        --greek|-G|G)           switch_to Greek GRE;;

        --start|-i|i|on|+)      ibus_start;;
        --stop|-o|o|off|-)      ibus_stop;;
        --minimal|-m|m)         ibus_start_minimal;;    # Start IBus and then kill GTK UI. Workaround for Cinnamon bug.
        --kill-gtk-ui|-x|x)     ibus_kill_gtk_ui;;
        --restart|-r|r)         ibus_restart;;

        --setup|-s|s)           ibus_setup;;
        --help|-h|h)            usage;;

        -*)                     usage "Unrecognized option: ${1}";;
        *)                      usage;;
    esac || exit $?
    shift
done

exit 0
