#!/usr/bin/env bash
# Create a tar.gz containing a clone at HEAD, including .git and .gitignore files.
# Ignored/untracked working-tree files are excluded.
set -euo pipefail

usage() {
  echo 'Usage: git-tar REPOSITORY [OUTPUT.tar.gz]' >&2
  exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage
repo=$1
if ! root=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null); then
  echo "git-tar: not a Git working tree: $repo" >&2
  exit 1
fi
root=$(cd "$root" && pwd -P)
name=$(basename "$root")
output=${2:-"$PWD/$name.tar.gz"}

# Resolve output before changing directories; tar must not overwrite the source.
case $output in
  /*) ;;
  *) output="$PWD/$output" ;;
esac

command -v tar >/dev/null || { echo 'git-tar: tar is required' >&2; exit 1; }

# A clone includes self-contained Git metadata and checks out all committed files,
# including files marked export-ignore (which `git archive` would omit).
tmp=$(mktemp -d "${TMPDIR:-/tmp}/git-tar.XXXXXXXX")
clone="$tmp/$name"
cleanup() {
  rm -rf -- "$tmp"
}
trap cleanup EXIT HUP INT TERM

head=$(git -C "$root" rev-parse HEAD)
git clone --quiet --no-hardlinks --no-checkout -- "$root" "$clone"
git -C "$clone" checkout --quiet --detach "$head"
mkdir -p -- "$(dirname -- "$output")"
tar -C "$tmp" -czf "$output" "$name"
printf 'Created %s from %s at %s\n' "$output" "$root" "$(git -C "$clone" rev-parse --short HEAD)"
