#!/usr/bin/env bash
# Archive the working tree and Git metadata, excluding only .gitignore'd files.
set -euo pipefail

usage() {
  echo 'Usage: git-tar REPOSITORY [OUTPUT.tar.gz]' >&2
  exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage
repo=$1
if ! root=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null); then
  echo "git-tar: not a Git working tree: $repo" >&2
  exit 1
fi
root=$(cd "$root" && pwd -P)
name=$(basename "$root")
parent=$(dirname -- "$root")
output=${2:-"$PWD/$name.tar.gz"}

# Resolve output before changing directories.
case $output in
  /*) ;;
  *) output="$PWD/$output" ;;
esac

command -v tar >/dev/null || { echo 'git-tar: tar is required' >&2; exit 1; }

tmp=$(mktemp -d "${TMPDIR:-/tmp}/git-tar.XXXXXXXX")
tmp=$(cd "$tmp" && pwd -P)
cleanup() {
  rm -rf -- "$tmp"
}
trap cleanup EXIT HUP INT TERM

# Git supplies ignore semantics (including nested rules and negations), while
# filesystem traversal preserves everything else: empty directories, untracked
# files, symlinks, and the original .git directory. Never reconstruct Git state.
declare -A ignored=()
shopt -s dotglob nullglob
archive_paths() {
  local path=$1 metadata=${2:-false} child excluded
  [[ $path != "$tmp" ]] || return 0
  [[ ! ${ignored["$path"]+present} ]] || return 0

  if [[ $metadata == false && ( -d "$path/.git" || -f "$path/.git" ) ]]; then
    # Deliberately omit --exclude-standard: global ignores and info/exclude
    # must not remove files from this archive. Tracked files are never ignored.
    git -C "$path" ls-files --others --ignored --directory \
      --exclude-per-directory=.gitignore -z > "$tmp/ignored"
    while IFS= read -r -d '' excluded; do
      ignored["$path/${excluded%/}"]=1
    done < "$tmp/ignored"
  fi

  printf '%s\0' "${path#"${parent%/}/"}"
  if [[ -d $path && ! -L $path ]]; then
    for child in "$path"/*; do
      if [[ $metadata == true || ${child##*/} == .git ]]; then
        archive_paths "$child" true
      else
        archive_paths "$child" false
      fi
    done
  fi
}

archive_paths "$root" > "$tmp/paths"
# NUL-delimited literal names handle newlines, wildcards, and leading dashes.
# Stage the archive outside the traversal so an output inside the repo cannot
# archive itself or change the source while tar is reading it.
tar -C "$parent" --null --verbatim-files-from --no-recursion \
  -czf "$tmp/archive.tar.gz" -T "$tmp/paths"
mkdir -p -- "$(dirname -- "$output")"
mv -T -- "$tmp/archive.tar.gz" "$output"
printf 'Created %s from %s\n' "$output" "$root"
