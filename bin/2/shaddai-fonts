#!/usr/bin/env bash
# Try console bitmap fonts; keep one or leave the console as we found it.

default_font=Lat2-Terminus16.psfu.gz
font_home=/etc/consolefonts/shaddai
font_loader=/usr/local/libexec/shaddai-console-font

usage() {
	cat <<'EOF'
Usage: shaddai [FONT-DIR]
       shaddai --tutorial
       shaddai --default

Preview Linux virtual-console fonts with setfont (from kbd).
Run on a console such as /dev/tty2. An optional directory supplies your fonts.

  n / p   next / previous font
  /       filter filenames (empty resets)
  d       toggle double size (requires a font at most 16x16)
  h / ?   tour the files and commands that control console fonts
  Enter   keep, then choose: temporary / this TTY / all TTYs
  q       quit and restore the original font

Sizes belong to the bitmap fonts: browse their size variants or use d.
The first preview is Lat2-Terminus16.psfu.gz when available.
--default saves that font as the shared default and loads it on allocated VTs.
Saving requires root (sudo is requested only when needed) and systemd.
TTY-specific choices override the shared default. Fonts belong to the console,
not a user: a saved choice also applies to other people using that TTY.
EOF
}

font_directory() {
	local directory
	for directory in /usr/share/kbd/consolefonts /usr/share/consolefonts \
		/usr/lib/kbd/consolefonts /etc/kbd/consolefonts \
		/run/current-system/sw/share/consolefonts; do
		[[ -d $directory ]] && { printf '%s\n' "$directory"; return; }
	done
	return 1
}

tour_page() {
	case $1 in
	1) cat <<EOF
1/5  A console is a device; a font is data

Run 'tty' to see where your shell is connected.
This session: ${console:-$(tty 2>/dev/null || true)}

/dev/tty2 is a Linux virtual console, usually reached with Ctrl-Alt-F2.
/dev/tty0 refers to the active VT; it is not a particular numbered TTY.
/dev/pts/2 is a terminal emulator or remote session. Its font lives in
the terminal application's settings, not in the kernel console.

A console font is a grid of pixels for each character. Loading a taller
font leaves fewer rows on screen. 'd' doubles each pixel (up to 16x16).
Unicode maps connect characters to glyphs; absent glyphs cannot be drawn.

The whole operation is an ordinary command:
  sudo setfont -C /dev/tty2 -m none /path/to/font.psfu.gz
EOF
	;;
	2) cat <<EOF
2/5  Find the actual font files

Font directory here:
  ${fontdir:-$(font_directory || printf '(install the kbd font data)')}

Common homes are /usr/share/kbd/consolefonts, /usr/share/consolefonts
and /etc/kbd/consolefonts. NixOS also exposes them under
/run/current-system/sw/share/consolefonts, pointing into /nix/store.

Try these yourself (use the directory shown above):
  ls /etc/kbd/consolefonts
  readlink -f /etc/kbd/consolefonts/$default_font
  man setfont

.psf is a bitmap font; .psfu usually includes a Unicode map.
.gz just means compressed; setfont can read it directly.
/usr/share/fonts, ~/.local/share/fonts and ~/.config/fontconfig control
desktop fonts. Installing a TTF there does not change a Linux TTY font.
EOF
	;;
	3) cat <<EOF
3/5  Try, save, restore: no magic state

setfont talks to the kernel through the console device. For example:
  sudo setfont -C /dev/tty2 -O /tmp/before.psf
  sudo setfont -C /dev/tty2 -m none /path/to/font.psfu.gz
  sudo setfont -C /dev/tty2 -m none /tmp/before.psf

-O saves the current glyphs AND their Unicode map without loading a font.
-m none leaves the existing byte-to-Unicode translation alone.
The chooser does the same thing: q, EOF and interrupts restore the saved
font. Enter keeps the preview, then offers to save it for future boots.

Saving captures the loaded font, including double size, as a plain PSF.
It keeps working if the original font directory is moved or removed.
There is no background chooser process and no new font format to learn.
EOF
	;;
	4) cat <<EOF
4/5  What loads a font at boot?

On systemd systems, systemd-vconsole-setup reads /etc/vconsole.conf:
  FONT=Lat2-Terminus16
Other entries there control the keymap and mapping tables.
Inspect yours:
  cat /etc/vconsole.conf
  readlink -f /etc/vconsole.conf

On NixOS this file is generated. The native declarative setting is:
  console.font = "Lat2-Terminus16";
in your NixOS configuration (often /etc/nixos/configuration.nix), then
'sudo nixos-rebuild switch'. Do not edit files inside /nix/store.

Debian's console-setup uses /etc/default/console-setup instead.
~/.profile, ~/.bash_profile and ~/.zprofile run at login, not early boot;
a setfont there affects a shared console, despite living in your home.
An initramfs may have an earlier font; changing that requires rebuilding
it through your distro. Kernel vconsole.font= can also override settings.
EOF
	;;
	5) cat <<EOF
5/5  The choices saved by shaddai

One file per choice, with a fallback:
  $font_home/tty2.psf   -> only /dev/tty2
  $font_home/default.psf -> all VTs without their own file

Two systemd drop-ins, both named 90-shaddai-font.conf:
  /etc/systemd/system/systemd-vconsole-setup.service.d/
  /etc/systemd/system/getty@.service.d/
They call $font_loader after native console setup
and before future login prompts. This also works with NixOS's generated
vconsole.conf. It takes effect after the early boot/initramfs stage.

Inspect: systemctl cat systemd-vconsole-setup.service getty@tty2.service
Reapply: sudo $font_loader /dev/tty2
Undo a TTY choice: sudo rm $font_home/tty2.psf
Undo the shared default: sudo rm $font_home/default.psf
Then: sudo systemctl restart systemd-vconsole-setup.service
Removing every saved PSF makes the hooks do nothing; native setup wins.
EOF
	;;
	esac
}

tutorial() {
	local page=1 key
	if [[ ! -t 0 || ! -t 1 ]]; then
		for page in 1 2 3 4 5; do tour_page "$page"; printf '\n'; done
		return
	fi
	while :; do
		printf '\033[H\033[2J'
		tour_page "$page"
		printf '\n[n/Enter] next  [p] back  [1-5] jump  [q] return: '
		IFS= read -rsn1 key || return 0
		case $key in
			n|'') (( page == 5 )) && return; (( page += 1 )) ;;
			p) (( page > 1 )) && (( page -= 1 )) ;;
			[1-5]) page=$key ;;
			q) return ;;
		esac
	done
}

as_root() {
	if (( EUID == 0 )); then "$@"; else sudo -- "$@"; fi
}

save_default() {
	local scope=$1 source=$2 name=default helper unit destination source_file mode
	[[ $scope == all || $scope == current ]] || return 1
	[[ $scope == current ]] && name=${console#/dev/}
	helper=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../lib/shaddai/console-font
	[[ -r $helper && -s $source ]] || { printf 'Missing loader or saved font.\n' >&2; return 1; }
	[[ -d /run/systemd/system ]] && command -v systemctl >/dev/null || {
		printf 'Saving requires systemd; the preview can still be kept temporarily.\n' >&2
		return 1
	}
	command -v setfont >/dev/null || { printf 'Install kbd to get setfont.\n' >&2; return 1; }
	if (( EUID != 0 )); then
		command -v sudo >/dev/null && sudo -v || return 1
	fi
	cat >"$savedir/vconsole.conf" <<EOF
# Load saved console fonts after the distribution's native setup.
[Service]
ExecStartPost=-$font_loader
EOF
	cat >"$savedir/getty.conf" <<EOF
# Also cover VTs allocated after boot. Never prevent login on font failure.
[Unit]
After=systemd-vconsole-setup.service
[Service]
ExecStartPre=-$font_loader /dev/%I
EOF
	# Install the hooks before publishing the font. With no saved PSF the
	# loader is a no-op. Rename each completed file so readers see whole files.
	for unit in loader vconsole getty; do
		case $unit in
			loader) source_file=$helper; destination=$font_loader; mode=0755 ;;
			vconsole) source_file=$savedir/vconsole.conf; destination=/etc/systemd/system/systemd-vconsole-setup.service.d/90-shaddai-font.conf; mode=0644 ;;
			getty) source_file=$savedir/getty.conf; destination=/etc/systemd/system/getty@.service.d/90-shaddai-font.conf; mode=0644 ;;
		esac
		as_root install -D -m "$mode" -- "$source_file" "$destination.new" &&
			as_root mv -fT -- "$destination.new" "$destination" || return 1
	done
	as_root systemctl daemon-reload || return 1
	destination=$font_home/$name.psf
	# Preserve the previous choice for recovery without making backups into
	# another active setting. Only files ending exactly in .psf are loaded.
	as_root sh -c 'if [ -f "$1" ]; then cp -p -- "$1" "$1.previous"; fi' sh "$destination" || return 1
	as_root install -D -m 0644 -- "$source" "$destination.new" &&
		as_root mv -fT -- "$destination.new" "$destination" || return 1
	printf '\nSaved %s\n' "$destination"
	printf 'Reload command: sudo %s' "$font_loader"
	[[ $scope == current ]] && printf ' %s' "$console"
	printf '\n'
	if [[ $scope == all ]]; then
		printf 'TTY-specific files still take priority over this shared default.\n'
		as_root "$font_loader"
	else
		as_root "$font_loader" "$console"
	fi || {
		printf 'Saved for the future, but some live consoles could not be updated.\n' >&2
		return 1
	}
}

keep_font() {
	local answer
	keep=1
	printf '\nKept on %s. Apply again with:\n  ' "$console"
	printf '%q ' setfont -C "$console" -m none "${font_options[@]}" "${fonts[index]}"
	printf '\n'
	while :; do
		printf '\nMake this font the default for future sessions and boots?\n'
		printf '  n  No, just keep it for now [default]\n'
		printf '  a  Yes, this TTY (%s), for everyone using it\n' "$console"
		printf '  b  Yes, all TTYs (TTY-specific saved choices take priority)\n'
		printf '  h  Show the font tutorial\nChoice [n/a/b/h]: '
		IFS= read -r answer || return 0
		case ${answer,,} in
			''|n|no) return 0 ;;
			h|'?') tutorial ;;
			a|b)
				if ! setfont -C "$console" -O "$savedir/selected.psf" || [[ ! -s $savedir/selected.psf ]]; then
					printf 'Could not capture the selected font; nothing saved.\n' >&2
					return 1
				fi
				if [[ ${answer,,} == a ]]; then answer=current; else answer=all; fi
				save_default "$answer" "$savedir/selected.psf" && return 0
				printf 'Could not finish persistence; the live preview is still kept. Retry or choose n.\n' >&2
				;;
			*) printf 'Choose n, a, b or h.\n' ;;
		esac
	done
}

die() {
	printf 'shaddai: %s\n' "$*" >&2
	exit 1
}

cleanup() {
	local status=$?
	trap - EXIT
	if (( saved && ! keep )); then
		if ! setfont -C "$console" -m none "$savedir/original.psf"; then
			printf '\nshaddai: restoration failed; saved font retained. Recover with:\n  ' >&2
			printf '%q ' setfont -C "$console" -m none "$savedir/original.psf" >&2
			printf '\n' >&2
			exit 1
		fi
	fi
	rm -rf -- "$savedir"
	exit "$status"
}

preview() {
	local size=normal
	font_options=()
	(( double )) && { font_options=(-d); size=double; }

	valid=0
	# Leave the console's byte-to-Unicode translation alone throughout.
	if setfont -C "$console" -m none "${font_options[@]}" "${fonts[index]}" 2>"$savedir/error"; then
		valid=1
	else
		# A failed load can still have changed the font or its Unicode map.
		setfont -C "$console" -m none "$savedir/original.psf" || die 'Could not restore the original font.'
	fi

	printf '\033[H\033[2J'
	printf 'shaddai  [%d/%d]  %s\n%s\n\n' "$((index + 1))" "${#fonts[@]}" "$size" "${fonts[index]##*/}"
	printf '%s\n' \
		'The quick brown fox jumps over the lazy dog.' \
		'ABCDEFGHIJKLMNOPQRSTUVWXYZ' \
		'abcdefghijklmnopqrstuvwxyz' \
		'0123456789  Il1|  O0  {} [] () <> /\' \
		'!@#$%^&*  +-=_  .,;:  "quotes"' \
		'é à ü ñ  α β Ω  ┌─┬─┐ │ └─┴─┘' \
		'' \
		'n/p next/previous   / filter   d double' \
		'h tutorial   Enter keep & persistence   q restore & quit'
	if (( ! valid )); then
		printf '\nCould not preview; original restored:\n'
		cat "$savedir/error"
	fi
}

main() {
case ${1:-} in
	-h|--help) usage; exit 0 ;;
	--tutorial) tutorial; return ;;
	--default)
		(( $# == 1 )) || die 'Usage: shaddai --default'
		fontdir=$(font_directory) || die 'No console font directory found.'
		[[ -r $fontdir/$default_font ]] || die "$default_font is not installed in $fontdir."
		saved=0 keep=1
		savedir=$(mktemp -d) || die 'Could not create a temporary directory.'
		trap cleanup EXIT
		gzip -cd -- "$fontdir/$default_font" >"$savedir/default.psf" || die 'Could not unpack default font.'
		save_default all "$savedir/default.psf"
		return ;;
	-*) usage >&2; return 1 ;;
esac
(( $# <= 1 )) || { usage >&2; exit 1; }
command -v setfont >/dev/null || die 'Install kbd to get setfont.'
console=$(tty) || die 'Run on a Linux virtual console (e.g. /dev/tty2).'
[[ $console =~ ^/dev/tty[1-9][0-9]*$ && -t 1 ]] ||
	die 'Run on a Linux virtual console (e.g. /dev/tty2).'

fontdir=${1:-}
if [[ -z $fontdir ]]; then
	fontdir=$(font_directory) || die 'No console font directory found; pass one as FONT-DIR.'
fi
[[ -d $fontdir ]] || die 'No console font directory found; pass one as FONT-DIR.'
fontdir=$(cd -- "$fontdir" && pwd -P) || exit 1

shopt -s nullglob
fonts=("$fontdir"/*.{psf,psfu,fnt}{,.gz,.bz2,.xz,.zst})
(( ${#fonts[@]} )) || die "No PSF, PSFU or FNT fonts in $fontdir."
mapfile -d '' -t fonts < <(printf '%s\0' "${fonts[@]}" | LC_ALL=C sort -zV)
all_fonts=("${fonts[@]}")

saved=0 keep=0 double=0 index=0
for i in "${!fonts[@]}"; do
	[[ ${fonts[i]##*/} == "$default_font" ]] && { index=$i; break; }
done
savedir=$(mktemp -d) || die 'Could not create a temporary directory.'
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# -O saves the glyphs and their Unicode map without loading another font.
setfont -C "$console" -O "$savedir/original.psf" ||
	die 'Could not save the current font; try running with sudo.'
[[ -s $savedir/original.psf ]] || die 'setfont did not save the current font.'
saved=1

preview
while IFS= read -rsn1 key; do
	case $key in
		n) (( index = (index + 1) % ${#fonts[@]} )) ;;
		p) (( index = (index + ${#fonts[@]} - 1) % ${#fonts[@]} )) ;;
		d) (( double = ! double )) ;;
		h|'?') tutorial ;;
		/)
			IFS= read -rp $'\nFilter: ' query || exit 0
			matches=()
			for font in "${all_fonts[@]}"; do
				name=${font##*/}
				[[ ${name,,} == *"${query,,}"* ]] && matches+=("$font")
			done
			if (( ! ${#matches[@]} )); then
				printf '\nNo matching fonts. Try / again.\n'
				continue
			fi
			fonts=("${matches[@]}") index=0
			;;
		'')
			(( valid )) || continue
			keep_font
			return $?
			;;
		q) exit 0 ;;
		*) continue ;;
	esac
	preview
done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
