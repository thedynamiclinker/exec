#!/bin/sh
# A TTY's own font wins; otherwise it inherits the shared default.
# Installed independently of the chooser so boot never depends on a checkout.
PATH=/run/current-system/sw/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

apply() {
    console=$1
    case ${console#/dev/tty} in
        ''|0*|*[!0-9]*) echo "shaddai: not a virtual console: $console" >&2; return 1 ;;
    esac
    [ "$console" != "${console#/dev/tty}" ] || return 1
    font=/etc/consolefonts/shaddai/${console#/dev/}.psf
    [ -f "$font" ] || font=/etc/consolefonts/shaddai/default.psf
    [ -f "$font" ] || return 0
    setfont -C "$console" -m none "$font"
}

if [ "$#" -eq 1 ]; then
    apply "$1"
elif [ "$#" -eq 0 ]; then
    status=0
    # /dev/tty1..63 exist even when unused. /dev/vcsN exists only for
    # allocated consoles, so this does not allocate dozens of new VTs.
    for screen in /dev/vcs[1-9]*; do
        [ -c "$screen" ] || continue
        apply "/dev/tty${screen#/dev/vcs}" || status=1
    done
    exit "$status"
else
    echo 'Usage: shaddai-console-font [/dev/ttyN]' >&2
    exit 1
fi
