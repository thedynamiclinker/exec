#!/usr/bin/env bash
set -euo pipefail
umask 022

root=$1
here=$(dirname -- "${BASH_SOURCE[0]}")
toybox=toybox-0.8.15
musl=musl-7813e9119eb5fe681b6750b8a033a0490bca0941

exec 9< "$root"
flock 9
if [[ -f "$root/etc/sinai" && -x "$root/bin/sh" && -x "$root/bin/lord" &&
      -f "$root/lib/libc.so" ]]; then
    printf 'sinai: %s is ready\n' "$root"
    exit
fi
if [[ ! -O "$root" ]]; then
    printf 'sinai: run make world as the owner of %s\n' "$root" >&2
    exit 1
fi

cache=${XDG_CACHE_HOME:-$HOME/.cache}/sinai
mkdir -p -- "$cache"
work=$(mktemp -d /tmp/sinai-build.XXXXXXXX)
trap 'rm -rf -- "$work"' EXIT

fetch() {
    local source=$1 url=$2 checksum=$3 archive=$cache/$1.tar.gz
    if ! [[ -f "$archive" ]] ||
        ! printf '%s  %s\n' "$checksum" "$archive" | cksum -a sha256 -c --status; then
        curl -fLsS --retry 3 -o "$work/$source.tar.gz" "$url"
        printf '%s  %s\n' "$checksum" "$work/$source.tar.gz" | cksum -a sha256 -c
        cp -- "$work/$source.tar.gz" "$archive"
    fi
    tar -xf "$archive" -C "$work"
}

printf 'sinai: building musl and Toybox for %s\n' "$(uname -m)"
fetch "$musl" "https://git.musl-libc.org/cgit/musl/snapshot/$musl.tar.gz" \
    8c16adf94bfd61358cf884353a4c0b71837ed792e7b7f056c86354436cf05bdb
fetch "$toybox" "https://landley.net/toybox/downloads/$toybox.tar.gz" \
    44e2bab43dfe2c171743297631ce558c6d9ed38b87a66fd751cef617574b375e

image=$work/root
mkdir -p "$image"/{bin,dev,etc,lib,proc,root,run/sinai,sys,tmp,usr} "$work/uapi"
chmod 1777 "$image/tmp"
ln -s ../bin "$image/usr/bin"

hostcc=$(type -P gcc)
targetcc=$hostcc
binutils_flag=
compiler=$(realpath -- "$hostcc")
nix_support=${compiler%/bin/*}/nix-support
if [[ -r "$nix_support/orig-cc" ]]; then
    targetcc=$(< "$nix_support/orig-cc")/bin/gcc
    linker=$(realpath -- "$(type -P ld)")
    binutils_flag=-B$(< "${linker%/bin/*}/nix-support/orig-bintools")/bin/
fi
# Reuse the host's Linux UAPI headers without adding its libc headers.
uapi=$("$hostcc" -M -xc - <<< '#include <linux/version.h>' |
    sed -n 's/^[[:blank:]]*\(.*\)\/linux\/version\.h.*/\1/p')
asm=$("$hostcc" -M -xc - <<< '#include <asm/types.h>' |
    sed -n 's/^[[:blank:]]*\(.*\)\/asm\/types\.h.*/\1/p')
for dir in linux asm-generic drm mtd sound scsi rdma misc; do
    if [[ -d "$uapi/$dir" ]]; then
        ln -s "$uapi/$dir" "$work/uapi/$dir"
    fi
done
ln -s "$asm/asm" "$work/uapi/asm"

jobs=$(nproc)
(
    cd "$work/$musl"
    ./configure --prefix=/usr --libdir=/lib --syslibdir=/lib CC="$hostcc"
    make -j"$jobs"
    make DESTDIR="$image" install-libs install-headers
) > "$work/musl.log" 2>&1 || { tail -40 "$work/musl.log" >&2; exit 1; }
loader=("$image"/lib/ld-musl-*.so.1)
ln -sfn libc.so "${loader[0]}"
rm -- "$image/lib/musl-gcc.specs"
sh "$work/$musl/tools/musl-gcc.specs.sh" "$image/usr/include" "$image/lib" \
    "/lib/${loader[0]##*/}" > "$work/musl.specs"
atomic_flag=
if "$targetcc" -x c -fno-link-libatomic -fsyntax-only /dev/null 2>/dev/null; then
    atomic_flag=-fno-link-libatomic
fi
printf '#!/bin/sh\nexec %q %s %s "$@" -specs %q\n' \
    "$targetcc" "$atomic_flag" "$binutils_flag" "$work/musl.specs" > "$work/musl-gcc"
chmod +x "$work/musl-gcc"

(
    cd "$work/$toybox"
    printf 'CONFIG_SH=y\nCONFIG_GZIP=y\nCONFIG_AWK=y\nCONFIG_TR=y\n' > "$work/toyconfig"
    KCONFIG_ALLCONFIG="$work/toyconfig" scripts/genconfig.sh -d
    make -j"$jobs" CC="$work/musl-gcc" HOSTCC="$hostcc" CFLAGS="-O2 -idirafter $work/uapi"
    PREFIX="$image/bin" make install_flat CC="$work/musl-gcc" HOSTCC="$hostcc"
) > "$work/toybox.log" 2>&1 || { tail -40 "$work/toybox.log" >&2; exit 1; }
"$work/musl-gcc" -Os -Wall -Wextra -s -o "$image/bin/lord" "$here/lord.c"

printf 'root:x:0:0:root:/root:/bin/sh\n' > "$image/etc/passwd"
printf 'root:x:0:\n' > "$image/etc/group"
printf '127.0.0.1 localhost sinai\n::1 localhost\n' > "$image/etc/hosts"
cp -L -- /etc/resolv.conf "$image/etc/resolv.conf"
cat > "$image/AGENTS.md" <<'EOF'
# Sinai

This directory is the root of the Sinai system. Map guest paths such as
`/bin` and `/etc` to paths under this directory when working from the host.
Use `sinai chroot COMMAND` to run a command with Sinai as its root.
EOF
printf 'sinai: checking the shell and musl loader\n'
bwrap --unshare-user --uid 0 --gid 0 --bind "$image" / --dev /dev \
    --setenv PATH /bin -- /bin/sh -c 'echo sinai | /bin/grep -qx sinai'

# Publish missing files only. A repeated build leaves the evolving world alone.
cp -a --update=none -- "$image/." "$root/"
printf '%s\n%s\n' "$toybox" "$musl" > "$work/sinai"
mv -- "$work/sinai" "$root/etc/sinai"
printf 'sinai: %s is ready\n' "$root"
